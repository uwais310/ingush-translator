# Скопируйте этот файл, назовите копию .env и впишите свой ключ после знака =
# Ключ Gemini бесплатный: https://aistudio.google.com/apikey
# Файл .env остаётся только на вашем компьютере. Никому его не отправляйте и не выкладывайте.

GEMINI_API_KEY=

# ИИ выключен по умолчанию: переводчик работает по базе, словарям, правилам и «по кускам».
# Чтобы снова включить ИИ как последний шаг, раскомментируйте строку ниже.
# USE_AI=1

# Необязательно: запасные бесплатные ИИ, если Gemini занят
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Необязательно: код для кнопки «Исправить» и страницы /review
# EDITOR_CODE=

# Необязательно: код для админки /admin (что переводили и жалобы «Неправильный перевод?»).
# Без него админка выключена. ADMIN_LOG=0 — не вести журнал переводов.
# ADMIN_CODE=

# Необязательно: свой список моделей Gemini через запятую (по умолчанию берётся самая новая Flash)
# GEMINI_MODELS=

# Необязательно: другой порт; HOST=127.0.0.1 — открывать сайт только на этом компьютере
# PORT=3000
# HOST=127.0.0.1
